                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>subActivityType</key>
                    <value>GroovyScript</value>
                </ifl:property>
                <ifl:property>
                    <key>script</key>
                    <value>3_BuildPdfReport.groovy</value>
                </ifl:property>
                <ifl:property>
                    <key>scriptFunction</key>
                    <value></value>
