                <value>false</value>
            </ifl:property>
            <ifl:property>
                <key>componentVersion</key>
                <value>1.2</value>
            </ifl:property>
        </bpmn2:extensionElements>
        <bpmn2:participant id="Participant_1" ifl:type="EndpointSender" name="Sender">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>enableBasicAuthentication</key>
                    <value>false</value>
                </ifl:property>
                <ifl:property>
                    <key>ifl:type</key>
                    <value>EndpointSender</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Sender/version::1.0</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.0</value>
                </ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:participant>
        <bpmn2:participant id="Participant_Mail" ifl:type="EndpointRecevier" name="Mail Receiver">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>ifl:type</key>
                    <value>EndpointRecevier</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Receiver/version::1.0</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.0</value>
                </ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:participant>
        <bpmn2:participant id="Participant_Process_1" ifl:type="IntegrationProcess" name="Integration Process" processRef="Process_1">
            <bpmn2:extensionElements />
        </bpmn2:participant>
        <bpmn2:messageFlow id="MessageFlow_Mail" name="Send Report Mail" sourceRef="EndEvent_SendMail" targetRef="Participant_Mail">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>ComponentType</key>
                    <value>Mail</value>
                </ifl:property>
                <ifl:property>
                    <key>direction</key>
                    <value>Receiver</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::AdapterVariant/cname::mail-smtp/tp::HCIMail/mp::Mail/direction::Receiver/version::1.1.2</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>smtpProtocol</key>
                    <value>SMTPS</value>
                </ifl:property>
                <ifl:property>
                    <key>host</key>
                    <value>smtp.gmail.com</value>
                </ifl:property>
                <ifl:property>
                    <key>port</key>
                    <value>465</value>
                </ifl:property>
                <ifl:property>
                    <key>authentication</key>
                    <value>UserCredentials</value>
                </ifl:property>
                <ifl:property>
                    <key>credentialName</key>
                    <value>Gmail_SMTP_Credential</value>
                </ifl:property>
                <ifl:property>
                    <key>from</key>
                    <value>{{MailFrom}}</value>
                </ifl:property>
                <ifl:property>
                    <key>to</key>
                    <value>{{MailTo}}</value>
                </ifl:property>
                <ifl:property>
                    <key>subject</key>
                    <value>Trading Advisor Report (SAP CPI)</value>
                </ifl:property>
                <ifl:property>
                    <key>contentType</key>
                    <value>text/plain</value>
                </ifl:property>
                <ifl:property>
                    <key>bodyText</key>
                    <value>Bijgevoegd het trading advies rapport, gegenereerd door de SAP CPI Trading iFlow. Educatief onderzoek, geen financieel advies.</value>
                </ifl:property>
                <ifl:property>
                    <key>createAttachment</key>
                    <value>true</value>
                </ifl:property>
                <ifl:property>
                    <key>attachmentFileName</key>
                    <value>trading_cpi_report.pdf</value>
                </ifl:property>
                <ifl:property>
                    <key>attachmentContentType</key>
                    <value>application/pdf</value>
                </ifl:property>
            </bpmn2:extensionElements>
        </bpmn2:messageFlow>
    </bpmn2:collaboration>

    <bpmn2:process id="Process_1" name="Integration Process">
        <bpmn2:extensionElements>
            <ifl:property>
                <key>cmdVariantUri</key>
                <value>ctype::FlowElementVariant/cname::IntegrationProcess/version::1.2.1</value>
            </ifl:property>
            <ifl:property>
                <key>transactionTimeout</key>
                <value>30</value>
            </ifl:property>
            <ifl:property>
                <key>componentVersion</key>
                <value>1.2</value>
            </ifl:property>
            <ifl:property>
                <key>transactionalHandling</key>
                <value>Not Required</value>
            </ifl:property>
        </bpmn2:extensionElements>

        <bpmn2:startEvent id="StartEvent_Timer" name="Weekday Schedule">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::TimerStartEvent/cname::CronTimer/version::1.1.2</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>cycleType</key>
                    <value>Custom</value>
                </ifl:property>
                <ifl:property>
                    <key>scheduleCronExpression</key>
                    <value>{{ScheduleCronExpression}}</value>
                </ifl:property>
                <ifl:property>
                    <key>ScheduleTimeZone</key>
                    <value>Europe/Amsterdam</value>
                </ifl:property>
                <ifl:property>
                    <key>scheduleKeepRunning</key>
                    <value>true</value>
                </ifl:property>
                <ifl:property>
                    <key>throwException</key>
                    <value>false</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>
            <bpmn2:timerEventDefinition id="TimerEventDefinition_1" />
        </bpmn2:startEvent>

        <bpmn2:callActivity id="CallActivity_SetParams" name="Set Parameters">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::MessageContentModifier/version::1.1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value>[["CryptoFocus","","constant","{{CryptoFocus}}",""],["StockFocus","","constant","{{StockFocus}}",""],["ClaudeModel","","constant","{{ClaudeModel}}",""],["MailFrom","","constant","{{MailFrom}}",""],["MailTo","","constant","{{MailTo}}",""]]</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>
        </bpmn2:callActivity>

        <bpmn2:callActivity id="CallActivity_FetchData" name="Fetch Market Data">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>activityType</key>
                    <value>Script</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::GroovyScript/version::1.1.0</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.1</value>
                </ifl:property>
                <ifl:property>
                    <key>subActivityType</key>
                    <value>GroovyScript</value>
                </ifl:property>
                <ifl:property>
                    <key>script</key>
                    <value>1_FetchMarketData.groovy</value>
                </ifl:property>
                <ifl:property>
                    <key>scriptFunction</key>
                    <value></value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>
        </bpmn2:callActivity>

        <bpmn2:callActivity id="CallActivity_Claude" name="Ask Claude for Narrative">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>activityType</key>
                    <value>Script</value>
                </ifl:property>
