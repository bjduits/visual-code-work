                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_5</bpmn2:incoming>
            <bpmn2:messageEventDefinition />
        </bpmn2:endEvent>

        <bpmn2:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Timer" targetRef="CallActivity_SetParams" />
        <bpmn2:sequenceFlow id="SequenceFlow_2" sourceRef="CallActivity_SetParams" targetRef="CallActivity_FetchData" />
        <bpmn2:sequenceFlow id="SequenceFlow_3" sourceRef="CallActivity_FetchData" targetRef="CallActivity_Claude" />
        <bpmn2:sequenceFlow id="SequenceFlow_4" sourceRef="CallActivity_Claude" targetRef="CallActivity_BuildPdf" />
        <bpmn2:sequenceFlow id="SequenceFlow_5" sourceRef="CallActivity_BuildPdf" targetRef="EndEvent_SendMail" />
    </bpmn2:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="Default Collaboration Diagram">
        <bpmndi:BPMNPlane bpmnElement="Collaboration_1" id="BPMNPlane_1">
