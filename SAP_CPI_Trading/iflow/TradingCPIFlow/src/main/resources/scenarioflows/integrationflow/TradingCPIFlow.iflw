            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="CallActivity_BuildPdf" id="BPMNShape_CallActivity_BuildPdf">
                <dc:Bounds height="60.0" width="100.0" x="750.0" y="136.0" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="EndEvent_SendMail" id="BPMNShape_EndEvent_SendMail">
                <dc:Bounds height="32.0" width="32.0" x="920.0" y="150.0" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_1" id="BPMNEdge_SequenceFlow_1" sourceElement="BPMNShape_StartEvent_Timer" targetElement="BPMNShape_CallActivity_SetParams">
                <di:waypoint x="252.0" xsi:type="dc:Point" y="166.0" />
                <di:waypoint x="300.0" xsi:type="dc:Point" y="166.0" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_2" id="BPMNEdge_SequenceFlow_2" sourceElement="BPMNShape_CallActivity_SetParams" targetElement="BPMNShape_CallActivity_FetchData">
                <di:waypoint x="400.0" xsi:type="dc:Point" y="166.0" />
                <di:waypoint x="450.0" xsi:type="dc:Point" y="166.0" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_3" id="BPMNEdge_SequenceFlow_3" sourceElement="BPMNShape_CallActivity_FetchData" targetElement="BPMNShape_CallActivity_Claude">
                <di:waypoint x="550.0" xsi:type="dc:Point" y="166.0" />
                <di:waypoint x="600.0" xsi:type="dc:Point" y="166.0" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_4" id="BPMNEdge_SequenceFlow_4" sourceElement="BPMNShape_CallActivity_Claude" targetElement="BPMNShape_CallActivity_BuildPdf">
                <di:waypoint x="700.0" xsi:type="dc:Point" y="166.0" />
                <di:waypoint x="750.0" xsi:type="dc:Point" y="166.0" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_5" id="BPMNEdge_SequenceFlow_5" sourceElement="BPMNShape_CallActivity_BuildPdf" targetElement="BPMNShape_EndEvent_SendMail">
                <di:waypoint x="850.0" xsi:type="dc:Point" y="166.0" />
                <di:waypoint x="920.0" xsi:type="dc:Point" y="166.0" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="MessageFlow_Mail" id="BPMNEdge_MessageFlow_Mail" sourceElement="BPMNShape_EndEvent_SendMail" targetElement="BPMNShape_Participant_Mail">
                <di:waypoint x="952.0" xsi:type="dc:Point" y="166.0" />
